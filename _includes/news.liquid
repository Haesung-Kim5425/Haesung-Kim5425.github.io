{%- comment -%}
  LOCAL OVERRIDE of al_folio_core 1.0.15's _includes/news.liquid.

  One line differs from upstream: the date column is formatted '%Y' instead of
  '%b %d, %Y'.

  Why: most items in _news/ are known only to a month or an academic term — "Fall
  2025", "August 2025". The upstream format would print "Sep 01, 2025" for those,
  inventing a day that no source records. Each item's own text carries whatever
  precision is actually known, so the column shows the year and nothing more.

  If a future al-folio upgrade changes this include, diff it against the gem copy at
  vendor/bundle/ruby/*/gems/al_folio_core-*/_includes/news.liquid and re-apply just the
  date format change. If every news item ever gains a real day-level date, delete this
  file and let the theme's version take over again.
{%- endcomment -%}
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
